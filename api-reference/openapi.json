                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/payments/btc": {
      "post": {
        "tags": [
          "Transactions",
          "BTC"
        ],
        "summary": "Create BTC Transaction",
        "description": "Create a new BTC transaction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBTCTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "BTC transaction created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBTCTransactionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transactions/remittances/pix": {
      "post": {
