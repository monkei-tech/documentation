          },
          "method": {
            "type": "string",
            "enum": [
              "PIX",
              "BTC",
              "USDT"
            ],
            "description": "Withdrawal method",
            "example": "PIX"
          },
          "fiat_amount": {
            "type": "integer",
            "format": "int64",
            "description": "Amount to withdraw in smallest unit (cents for fiat currency, required for fiat withdrawals)",
            "example": 10050
          },
          "crypto_amount": {
            "type": "integer",
            "format": "int64",
            "description": "Amount in crypto to withdraw in smallest unit (required for crypto withdrawals)",
            "example": 100000
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "description": "Description for the withdrawal",
            "example": "Withdrawal to bank account"
          },
          "network": {
            "type": "string",
            "enum": ["POLYGON", "LIGHTNING"],
            "description": "Network for crypto withdrawals (required for USDT/USDC)",
            "example": "POLYGON"
          },
          "to_address": {
            "type": "string",
            "description": "Destination address for crypto withdrawals (required for USDT/USDC)",
            "example": "0x1234567890123456789012345678901234567890"
          },
          "pix_key": {
            "type": "string",
            "description": "PIX key for PIX withdrawals (required for PIX)",
            "example": "user@example.com"
          },
          "pix_key_type": {
            "type": "string",
            "enum": ["EMAIL", "PHONE", "CPF", "CNPJ", "RANDOM"],
            "description": "PIX key type for PIX withdrawals (required for PIX)",
            "example": "EMAIL"
          }
