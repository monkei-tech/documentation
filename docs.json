{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Monkei",
  "colors": {
    "primary": "#223825",
    "light": "#354D3A",
    "dark": "#000000"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "testing"
            ]
          },
          {
            "group": "API Concepts",
            "icon": "book",
            "pages": [
              "essentials/authentication",
              "essentials/webhooks",
              "essentials/rate-limits"
            ]
          },
          {
            "group": "Billing",
            "icon": "receipt",
            "pages": [
              "billing/overview",
              "billing/create",
              "billing/list",
              "billing/find"
            ]
          },
          {
            "group": "Coupons",
            "icon": "tag",
            "pages": [
              "coupons/overview",
              "coupons/create",
              "coupons/list",
              "coupons/find"
            ]
          },
          {
            "group": "Transactions",
            "icon": "credit-card",
            "pages": [
              "transactions/overview",
              "transactions/pix",
              "transactions/usdt",
              "transactions/btc",
              "transactions/check-status"
            ]
          },
          {
            "group": "Withdrawals",
            "icon": "arrow-up-from-bracket",
            "pages": [
              "withdrawals/overview",
              "withdrawals/create"
            ]
          },
          {
            "group": "Accounts",
            "icon": "wallet",
            "pages": [
              "accounts/overview",
              "balance",
              "limits"
            ]
          },
          {
            "group": "Health",
            "icon": "heart-pulse",
            "pages": [
              "health/overview",
              "health/health"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "icon": "book",
            "pages": [
              "api-reference/introduction",
              "api-reference/billing/create",
              "api-reference/billing/list",
              "api-reference/billing/find",
              "api-reference/coupons",
              "api-reference/transactions/withdrawals",
              "api-reference/transactions/payments/pix",
              "api-reference/transactions/payments/usdt",
              "api-reference/transactions/payments/btc",
              "api-reference/transactions/payments/check",
              "api-reference/quotes/latest",
              "api-reference/accounts/balance"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://stats.uptimerobot.com/nAsS6FyoB3",
          "icon": "chart-line"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@monkei.co",
          "icon": "headset"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/monkei-tech",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo-verde.png",
    "dark": "/logo/logo-branca.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.monkei.co"
      },
      {
        "label": "Status",
        "href": "https://stats.uptimerobot.com/nAsS6FyoB3"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/monkeioffcial",
      "github": "https://github.com/monkei-tech",
      "linkedin": "https://linkedin.com/company/monkeitech"
    }
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "all",
      "prefill": true
    }
  }
}