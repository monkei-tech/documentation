{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Monkei Gateway API v1",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A855F7",
    "dark": "#5B21B6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "API Concepts",
            "pages": [
              "essentials/authentication",
              "essentials/rate-limits",
              "essentials/webhooks",
              "essentials/errors"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Transactions",
            "pages": [
              "api-reference/transactions/payments",
              "api-reference/transactions/pix",
              "api-reference/transactions/usdt",
              "api-reference/transactions/remittances",
              "api-reference/transactions/withdrawals"
            ]
          },
          {
            "group": "Billing",
            "pages": [
              "api-reference/billing/bills"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "href": "https://status.monkei.com",
          "icon": "chart-line"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@monkei.com",
          "icon": "headset"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/monkei",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://dashboard.monkei.com"
      },
      {
        "label": "Status",
        "href": "https://status.monkei.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://dashboard.monkei.com/api-keys"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/monkei",
      "github": "https://github.com/monkei",
      "linkedin": "https://linkedin.com/company/monkei"
    }
  }
}
